# LLM used to write the actual review comments.
GEMINI_API_KEY=

# Used for retrieval embeddings (text-embedding-3-small).
OPENAI_API_KEY=

# GitHub PAT with repo read access (and, for the webhook flow, permission to
# post PR review comments).
GITHUB_TOKEN=

# Secret configured on the GitHub webhook (Settings > Webhooks). Required for
# /webhook/github to accept requests.
GITHUB_WEBHOOK_SECRET=

# Optional: enables review-call tracking (model, prompt tokens, retrieved
# chunk ids, latency) to Weights & Biases. Leave unset to disable tracking.
WANDB_API_KEY=
WANDB_PROJECT=pr-reviewer-rag

# Optional: where per-repo FAISS indexes are persisted. Defaults to
# ./.rag_index locally, or /tmp/rag_index when VERCEL is set (Vercel's
# filesystem is read-only outside /tmp — see README for why this means the
# index doesn't survive across deployments there).
RAG_INDEX_DIR=

# Optional: set to "false" to disable the BM25 lexical rerank step and use
# raw FAISS cosine ranking only. Defaults to true.
RAG_USE_BM25_RERANK=
